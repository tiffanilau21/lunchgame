<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lunch Roulette Game - What to Eat Today?</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Fredoka', 'Inter', sans-serif;
            background: linear-gradient(135deg, #1a1c29 0%, #2b1055 100%);
            min-height: 100vh;
        }
        .glow-text {
            text-shadow: 0 0 20px rgba(236, 72, 153, 0.6), 0 0 40px rgba(168, 85, 247, 0.4);
        }
        .card-glow {
            box-shadow: 0 10px 30px -10px rgba(168, 85, 247, 0.3);
        }
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }
        .floating {
            animation: float 3s ease-in-out infinite;
        }
    </style>
</head>
<body class="text-white flex flex-col items-center justify-between p-4 sm:p-8 min-h-screen">

    <header class="text-center mt-4 mb-6">
        <div class="inline-block bg-pink-500/20 border border-pink-500/40 text-pink-300 px-4 py-1.5 rounded-full text-sm font-semibold mb-3 tracking-wider uppercase backdrop-blur-md">
            🎮 Ultimate Lunch Picker
        </div>
        <h1 class="text-4xl sm:text-6xl font-bold tracking-tight glow-text mb-2">
            What's For Lunch?
        </h1>
        <p class="text-gray-300 text-sm sm:text-base max-w-md mx-auto">
            Spin the wheel, let destiny decide your meal today! No more endless discussions.
        </p>
    </header>

    <main class="w-full max-w-xl bg-slate-900/80 backdrop-blur-xl border border-slate-700/60 rounded-3xl p-6 sm:p-8 card-glow flex flex-col items-center relative overflow-hidden mb-6">
        
        <!-- Decorative background glow blobs -->
        <div class="absolute -top-24 -left-24 w-48 h-48 bg-purple-600/30 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-48 h-48 bg-pink-600/30 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Today's Date Banner -->
        <div id="date-banner" class="bg-slate-800/90 border border-slate-700 px-4 py-2 rounded-xl text-xs sm:text-sm font-medium text-purple-300 mb-6 flex items-center gap-2 shadow-inner">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span id="current-date-text">Loading date...</span>
        </div>

        <!-- Roulette Wheel / Slots Display Container -->
        <div class="w-full relative mb-8">
            <!-- Pointer Indicator -->
            <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 z-20 text-pink-500 text-2xl filter drop-shadow-[0_2px_8px_rgba(236,72,153,0.8)]">
                ▼
            </div>

            <!-- Restaurant Display Box -->
            <div id="slot-container" class="w-full h-36 sm:h-44 bg-gradient-to-b from-slate-800 to-slate-950 border-2 border-purple-500/50 rounded-2xl flex flex-col items-center justify-center relative overflow-hidden shadow-2xl transition-all duration-300">
                
                <!-- Background pattern -->
                <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#a855f7_1px,transparent_1px)] [background-size:16px_16px]"></div>

                <div id="restaurant-icon" class="text-4xl sm:text-5xl mb-2 floating">🍱</div>
                <div id="restaurant-name" class="text-2xl sm:text-4xl font-extrabold tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-white via-pink-200 to-purple-300 text-center px-4">
                    Ready to Spin!
                </div>
                <div id="restaurant-tag" class="text-xs sm:text-sm text-purple-400 mt-1 font-medium bg-purple-950/60 px-3 py-1 rounded-full border border-purple-800/50">
                    Click Spin Button Below
                </div>
            </div>
        </div>

        <!-- Restaurant Options Reference Grid -->
        <div class="w-full mb-8">
            <h3 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-3 text-center">Today's Restaurant Pool (5 Choices)</h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5" id="restaurant-chips">
                <!-- Chips will be injected via JS -->
            </div>
        </div>

        <!-- Action Controls -->
        <div class="w-full flex flex-col sm:flex-row gap-3">
            <button id="spin-btn" onclick="startSpinning()" class="flex-1 bg-gradient-to-r from-pink-500 via-purple-600 to-indigo-600 hover:from-pink-600 hover:to-indigo-700 text-white font-bold py-4 px-6 rounded-2xl shadow-lg shadow-purple-600/40 transform active:scale-95 transition-all duration-200 flex items-center justify-center gap-2 text-lg cursor-pointer">
                <span>🎰 Spin for Lunch!</span>
            </button>
            <button onclick="shareResult()" class="sm:w-auto bg-slate-800 hover:bg-slate-700 border border-slate-700 text-gray-200 font-semibold py-4 px-5 rounded-2xl transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer text-sm">
                <span>📋 Share Result</span>
            </button>
        </div>

        <!-- Status Message / Toast -->
        <div id="toast" class="mt-4 text-xs text-center text-pink-400 opacity-0 transition-opacity duration-300 font-medium">
            Result copied to clipboard successfully! 🎉
        </div>
    </main>

    <footer class="text-xs text-gray-500 text-center pb-2">
        Made with ❤️ for food lovers. Open in any browser to play anytime!
    </footer>

    <script>
        // Restaurant data source with icons and themes
        const restaurants = [
            { id: 1, name: "魚米", icon: "🍜", tag: "Rice Noodles & Fish Soup", color: "from-blue-500/20 to-cyan-500/20" },
            { id: 2, name: "金飯碗", icon: "🍛", tag: "Golden Rice Bowl Specials", color: "from-amber-500/20 to-yellow-500/20" },
            { id: 3, name: "三一餃子", icon: "🥟", tag: "Handmade Dumplings", color: "from-rose-500/20 to-orange-500/20" },
            { id: 4, name: "魚川居", icon: "🍲", tag: "Fish & Local Delicacies", color: "from-emerald-500/20 to-teal-500/20" },
            { id: 5, name: "幸福胖", icon: "🍞", tag: "Happy Bakery & Comfort Buns", color: "from-purple-500/20 to-pink-500/20" }
        ];

        let isSpinning = false;
        let selectedRestaurant = null;

        // Initialize Web Audio API sound generator (no external audio files needed)
        let audioCtx = null;
        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
        }

        function playBeep(freq, type = 'sine', duration = 0.1) {
            try {
                initAudio();
                if (!audioCtx) return;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = type;
                osc.frequency.value = freq;
                gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + duration);
            } catch (e) {
                // Ignore audio restriction errors before interaction
            }
        }

        function playWinSound() {
            try {
                initAudio();
                if (!audioCtx) return;
                const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
                notes.forEach((note, index) => {
                    setTimeout(() => {
                        playBeep(note, 'triangle', 0.25);
                    }, index * 120);
                });
            } catch (e) {}
        }

        // Display current date
        function updateDateBanner() {
            const options = { weekday: 'long', year: 'numeric', month: 'short', day: 'numeric' };
            const todayStr = new Date().toLocaleDateString(undefined, options);
            document.getElementById('current-date-text').innerText = `Today: ${todayStr}`;
        }

        // Render restaurant chips grid
        function renderChips() {
            const container = document.getElementById('restaurant-chips');
            container.innerHTML = restaurants.map(r => `
                <div id="chip-${r.id}" class="bg-slate-800/80 border border-slate-700/80 rounded-xl p-2.5 flex items-center gap-2.5 transition-all duration-300">
                    <span class="text-xl">${r.icon}</span>
                    <div class="overflow-hidden">
                        <div class="font-bold text-sm text-white truncate">${r.name}</div>
                        <div class="text-[10px] text-gray-400 truncate">${r.tag}</div>
                    </div>
                </div>
            `).join('');
        }

        // Spin animation logic
        function startSpinning() {
            if (isSpinning) return;
            isSpinning = true;

            const spinBtn = document.getElementById('spin-btn');
            spinBtn.disabled = true;
            spinBtn.classList.add('opacity-50', 'cursor-not-allowed');

            const nameEl = document.getElementById('restaurant-name');
            const iconEl = document.getElementById('restaurant-icon');
            const tagEl = document.getElementById('restaurant-tag');
            const containerEl = document.getElementById('slot-container');

            // Reset chips highlighting
            restaurants.forEach(r => {
                const chip = document.getElementById(`chip-${r.id}`);
                chip.className = "bg-slate-800/80 border border-slate-700/80 rounded-xl p-2.5 flex items-center gap-2.5 transition-all duration-300";
            });

            let elapsed = 0;
            let speed = 50; // initial speed in ms
            const totalDuration = 2500; // 2.5 seconds total spin time
            let currentIndex = Math.floor(Math.random() * restaurants.length);

            function spinStep() {
                currentIndex = (currentIndex + 1) % restaurants.length;
                const current = restaurants[currentIndex];

                // Update visual display
                nameEl.innerText = current.name;
                iconEl.innerText = current.icon;
                tagEl.innerText = current.tag;

                playBeep(400 + (currentIndex * 60), 'sine', 0.08);

                elapsed += speed;
                speed += 15; // Slow down gradually

                if (elapsed < totalDuration) {
                    setTimeout(spinStep, speed);
                } else {
                    // Final winner selected
                    selectedRestaurant = current;
                    
                    // Highlight selected chip
                    const winningChip = document.getElementById(`chip-${selectedRestaurant.id}`);
                    winningChip.className = "bg-purple-900/60 border-2 border-purple-400 rounded-xl p-2.5 flex items-center gap-2.5 transition-all duration-300 shadow-[0_0_15px_rgba(168,85,247,0.4)]";

                    // Animate container success state
                    containerEl.classList.add('scale-105', 'border-pink-500');
                    setTimeout(() => containerEl.classList.remove('scale-105'), 300);

                    playWinSound();

                    // Re-enable button
                    spinBtn.disabled = false;
                    spinBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                    spinBtn.innerHTML = `<span>🎲 Spin Again!</span>`;
                    isSpinning = false;
                }
            }

            spinStep();
        }

        // Share result functionality
        function shareResult() {
            if (!selectedRestaurant) {
                // If not spun yet, pick one or ask user to spin first
                startSpinning();
                return;
            }

            const todayStr = new Date().toLocaleDateString();
            const shareText = `🍽️ Today's Lunch Pick (${todayStr}): ${selectedRestaurant.icon} ${selectedRestaurant.name} (${selectedRestaurant.tag})! Chosen by Lunch Roulette 🎰`;

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(shareText).then(() => {
                    showToast();
                }).catch(() => {
                    fallbackCopy(shareText);
                });
            } else {
                fallbackCopy(shareText);
            }
        }

        function fallbackCopy(text) {
            const textarea = document.createElement("textarea");
            textarea.value = text;
            textarea.style.position = "fixed";
            document.body.appendChild(textarea);
            textarea.focus();
            textarea.select();
            try {
                document.execCommand('copy');
                showToast();
            } catch (err) {
                alert("Result: " + text);
            }
            document.body.removeChild(textarea);
        }

        function showToast() {
            const toast = document.getElementById('toast');
            toast.style.opacity = '1';
            setTimeout(() => {
                toast.style.opacity = '0';
            }, 3000);
        }

        // Initial setup on load
        window.onload = function() {
            updateDateBanner();
            renderChips();
        };
    </script>
</body>
</html>